#!/usr/bin/env python3
"""Tell the Pocket which screen HAT it has, and restart the Companion on it.

  fm1-screen oled      the 1.3" OLED HAT (over SPI, or I2C if its jumpers are moved: found by itself)
  fm1-screen lcd144    the 1.44" LCD HAT (ST7735S, 128x128 colour)
  fm1-screen lcd13     the 1.3" LCD HAT (ST7789, 240x240 colour)
  fm1-screen ask       the screen picker on the next start: each screen in turn asks for KEY1
  fm1-screen           says which it's set to

Run it as the user the Companion runs as (not with sudo). Holding KEY1 and KEY3 while the Companion starts opens
the picker too."""
import json
import subprocess
import sys
from pathlib import Path

SETTINGS = Path.home() / ".config" / "fm1-bridge" / "fm1-bridge.json"
CHOICES = ("oled", "lcd144", "lcd13", "ask")


def main(args):
    try:
        state = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        state = {}
    if not args:
        print("screen:", {"lcd": "lcd144"}.get(state.get("screen"), state.get("screen") or "oled"))
        return 0
    if args[0] not in CHOICES:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    state["screen"] = args[0]
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(state, indent=2))
    print("screen:", args[0])
    try:
        restarted = subprocess.run(["systemctl", "--user", "restart", "fm1-bridge"]).returncode == 0
    except OSError:
        restarted = False
    if not restarted:
        print("Saved; the Companion wasn't restarted (start it, or reboot)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
